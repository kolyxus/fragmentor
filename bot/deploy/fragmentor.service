# systemd unit for the Fragmentor bot. Installed as
# /etc/systemd/system/fragmentor.service, see bot/DEPLOY.md.
#
# The server (1 GB of RAM) also runs the VPN: Xray in Docker on port 443.
# The bot leaves it alone: it listens on no ports and does not use Docker.
#
# Layout on the server:
#   /opt/fragmentor/fragmentor       the binary (make build-linux)
#   /etc/fragmentor/fragmentor.env   settings and secrets, root-only;
#                                    systemd reads it and passes it as env
#   /var/lib/fragmentor/             the database, created by systemd
#                                    (StateDirectory) and owned by the bot

[Unit]
Description=Fragmentor Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fragmentor
Group=fragmentor
ExecStart=/opt/fragmentor/fragmentor
WorkingDirectory=/var/lib/fragmentor
StateDirectory=fragmentor
StateDirectoryMode=0700
Environment=DATABASE_PATH=/var/lib/fragmentor/fragmentor.db
# Values from this file override Environment= above.
EnvironmentFile=/etc/fragmentor/fragmentor.env

# Restart after any exit but systemctl stop. The bot stops on SIGTERM:
# polling ends, updates in progress are answered, the database is closed.
Restart=always
RestartSec=5

# Memory: when it runs short, the bot goes, the VPN stays.
# - GOMEMLIMIT: past it the Go GC works harder to stay under it.
# - MemoryHigh: the kernel reclaims the bot's cache and throttles it. Kept
#   just under MemoryMax on purpose: with a wide gap a bot that needs more
#   hangs throttled for minutes instead of being killed and restarted.
# - MemoryMax of RAM plus MemorySwapMax of swap: past both the kernel kills
#   the bot alone and systemd restarts it. MemoryMax does not count swap, so
#   without MemorySwapMax the bot could take all of it.
# - OOMScoreAdjust: if the whole system runs out of memory, the bot is the
#   first victim.
# Checked on step 4: parsing two demos at once peaks at 98-115 MiB of RSS,
# far below these limits; see docs/DECISIONS.md.
Environment=GOMEMLIMIT=320MiB
MemoryHigh=380M
MemoryMax=400M
MemorySwapMax=128M
OOMScoreAdjust=1000

# Sandbox: the bot writes only to its state directory and talks to the
# network, nothing else. Unknown options on an older systemd are ignored
# with a warning.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
