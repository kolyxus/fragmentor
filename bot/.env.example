# Скопируй этот файл в bot/.env и заполни значения. Файл .env не попадает в git.
TELEGRAM_BOT_TOKEN=
# Только локально: токен отдельного бота для разработки. Если задан, бот берёт его
# вместо TELEGRAM_BOT_TOKEN, который тогда можно не указывать. На сервере не задаётся.
TELEGRAM_DEV_BOT_TOKEN=
# Server-side ключ FACEIT Data API (developers.faceit.com → App Studio → API Keys). Обязателен.
FACEIT_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Лимиты для одного вызова LLM, включая ожидание и повтор после HTTP 429.
LLM_TIMEOUT=30s
LLM_MAX_TOKENS=1024
LLM_MAX_REQUEST_BYTES=65536
LLM_MAX_RESPONSE_BYTES=1048576
LLM_MAX_RETRIES=1
DATABASE_PATH=./data/fragmentor.db
LOG_LEVEL=info
# Telegram ID админов через запятую. До шага 12 только они могут присылать демки на разбор.
ADMIN_TELEGRAM_IDS=
FREE_ANALYSES=3
